# Contact email — jahan form submissions ayenge
CONTACT_EMAIL=bangernargish@gmail.com

# Resend API key — email bhejna ke liye
# Account banaye: https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Session secret — koi bhi lamba random string
SESSION_SECRET=koi_bhi_lamba_random_string_yahan
